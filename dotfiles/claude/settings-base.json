      "mcp__plugin_slack_slack__slack_search_public_and_private",
      "mcp__plugin_slack_slack__slack_search_users"
    ],
    "ask": [
      "Bash(git -C * push --force-with-lease:*)",
      "Bash(git -C * push --force:*)",
      "Bash(git -C * push -f:*)",
      "Bash(git -C * rebase:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(gp --force-with-lease:*)",
      "Bash(gp --force:*)",
      "Bash(gp -f:*)",
      "Bash(gpsup --force-with-lease:*)",
      "Bash(gpsup --force:*)",
      "Bash(gpsup -f:*)",
      "Bash(grb:*)",
      "Bash(grbm:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(gf --all:*)",
      "Bash(gfo --all:*)",
      "Bash(git -C * fetch --all:*)",
      "Bash(git fetch --all:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "thinkingBudgetTokens": 1048576,
  "verbose": false
}
