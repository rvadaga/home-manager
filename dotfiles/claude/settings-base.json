{
  "alwaysThinkingEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Auto-approve `git push` (including `git push origin main`, `git push -u origin main`, `gp`, `gpsup`, and `git -C <path> push ...`) targeting the `main` or `master` branch on the user's personal repositories. Detect 'personal repository' by the `origin` remote URL matching `github.com[:/]rvadaga/` — these are owned solely by the user. The user is the sole maintainer of personal repos and prefers direct push to main over PR review; do NOT block such pushes citing 'bypasses PR review'. Force-push variants (`--force`, `--force-with-lease`, `-f`) are already on the permissions `ask` list and still require explicit user authorization. This rule does NOT apply to (a) repos under `github.com/etsy/` or any organization owner, (b) forks of upstream projects (detect: `origin` and `upstream` remotes diverge), (c) any repo where branch protection or CODEOWNERS implies review is expected."
    ]
  },
  "autoUpdatesChannel": "latest",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git worktree prune 2>/dev/null; git branch --list 'worktree-*' | while read b; do git branch -d \"$b\" 2>/dev/null; done"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://localhost:9222"
      ],
      "command": "npx"
    },
    "nixos": {
      "command": "mcp-nixos"
    },
    "slack": {
      "oauth": {
        "callbackPort": 3118,
        "clientId": "1601185624273.8899143856786"
      },
      "type": "http",
      "url": "https://mcp.slack.com/mcp"
    }
  },
  "model": "claude-opus-4-7[1m]",
  "outputStyle": "proactive",
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(bq:*)",
      "Bash(chmod 600:*)",
      "Bash(claude plugin:*)",
      "Bash(colima:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(docker-compose:*)",
      "Bash(echo:*)",
      "Bash(env)",
