{
  "alwaysThinkingEnabled": true,
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git worktree prune 2>/dev/null; git branch --list 'worktree-*' | while read b; do git branch -d \"$b\" 2>/dev/null; done"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://localhost:9222"
      ],
      "command": "npx"
    },
    "slack": {
      "oauth": {
        "callbackPort": 3118,
        "clientId": "1601185624273.8899143856786"
      },
      "type": "http",
      "url": "https://mcp.slack.com/mcp"
    }
  },
  "model": "claude-opus-4-7",
  "thinkingBudgetTokens": 1048576,
  "outputStyle": "explanatory",
  "permissions": {
    "allow": [
