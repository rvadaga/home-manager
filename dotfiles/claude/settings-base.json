  "mcpServers": {
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackPort": 3118
      }
    }
  },
  "model": "claude-opus-4-6",
  "outputStyle": "explanatory",
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(chmod 600:*)",
      "Bash(claude plugin:*)",
      "Bash(echo:*)",
      "Bash(env)",
      "Bash(find:*)",
      "Bash(ga:*)",
      "Bash(gd:*)",
      "Bash(gcloud:*)",
      "Bash(gcmsg:*)",
      "Bash(glog:*)",
      "Bash(gst:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(home-manager switch:*)",
      "Bash(hostname:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(node:*)",
      "Bash(nslookup:*)",
      "Bash(ping:*)",
      "Bash(readlink:*)",
      "Bash(sudo timeout:*)",
      "Bash(tail:*)",
      "Bash(time node:*)",
      "Bash(time:*)",
      "mcp__plugin_Notion_notion__notion-fetch",
      "WebFetch(domain:code.claude.com)",
      "WebSearch"
    ],
    "ask": [],
    "deny": []
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git worktree prune 2>/dev/null; git branch --list 'worktree-*' | while read b; do git branch -d \"$b\" 2>/dev/null; done"
          }
        ]
      }
    ]
  },
  "verbose": true
}
