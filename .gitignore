# nix result symlinks
result
result-*

# direnv
.direnv/

# backup files
*.bak
*.backup

# claude code internals (allow settings.json for nix merge)
.claude/*
!.claude/settings.json

# bootstrap state (sentinel files tracking completed one-time steps)
.state/

# per-machine identity (not portable across machines)
machine.json

# OS files
.DS_Store
