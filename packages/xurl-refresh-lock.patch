+// Reload replaces the in-memory snapshot with the current complete auth file.
+func (s *TokenStore) Reload() error {
+	data, err := os.ReadFile(s.FilePath)
+	if err != nil {
+		return errors.NewIOError(err)
+	}
+
+	var sf storeFile
+	if err := yaml.Unmarshal(data, &sf); err != nil {
+		return errors.NewJSONError(err)
+	}
+	if len(sf.Apps) == 0 {
+		return errors.NewTokenStoreError("token store has no apps")
+	}
+
+	s.Apps = sf.Apps
+	s.DefaultApp = sf.DefaultApp
+	for _, app := range s.Apps {
+		if app.OAuth2Tokens == nil {
+			app.OAuth2Tokens = make(map[string]Token)
+		}
+	}
+	return nil
+}
+
