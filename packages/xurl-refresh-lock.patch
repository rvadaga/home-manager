diff --git a/auth/refresh_lock_unix.go b/auth/refresh_lock_unix.go
new file mode 100644
index 0000000..dfcd72d
--- /dev/null
+++ b/auth/refresh_lock_unix.go
@@ -0,0 +1,37 @@
+//go:build !windows
+
+package auth
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+)
+
+// concurrent processes must share one token refresh at a time.
+func WithOAuth2TokenStoreLock(authFilePath string, operation func() error) error {
+	lockFile, err := os.OpenFile(authFilePath+".lock", os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return fmt.Errorf("open oauth2 token-store lock: %w", err)
+	}
+	defer lockFile.Close()
+
+	if err := syscall.Flock(int(lockFile.Fd()), syscall.LOCK_EX); err != nil {
+		return fmt.Errorf("lock oauth2 token store: %w", err)
+	}
+	defer func() {
+		_ = syscall.Flock(int(lockFile.Fd()), syscall.LOCK_UN)
+	}()
+
+	return operation()
+}
+
+func withOAuth2RefreshLock(authFilePath string, refresh func() (string, error)) (string, error) {
+	var accessToken string
+	err := WithOAuth2TokenStoreLock(authFilePath, func() error {
+		var refreshErr error
+		accessToken, refreshErr = refresh()
+		return refreshErr
+	})
+	return accessToken, err
+}
diff --git a/auth/refresh_lock_unix_test.go b/auth/refresh_lock_unix_test.go
new file mode 100644
index 0000000..f06cf63
--- /dev/null
+++ b/auth/refresh_lock_unix_test.go
@@ -0,0 +1,54 @@
+//go:build !windows
+
+package auth
+
+import (
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestOAuth2TokenStoreLockSerializesCallers(t *testing.T) {
+	tokenPath := filepath.Join(t.TempDir(), "auth.yml")
+	firstEntered := make(chan struct{})
+	releaseFirst := make(chan struct{})
+	firstDone := make(chan error, 1)
+	go func() {
+		err := WithOAuth2TokenStoreLock(tokenPath, func() error {
+			close(firstEntered)
+			<-releaseFirst
+			return nil
+		})
+		firstDone <- err
+	}()
+	<-firstEntered
+
+	secondEntered := make(chan struct{})
+	secondDone := make(chan error, 1)
+	go func() {
+		err := WithOAuth2TokenStoreLock(tokenPath, func() error {
+			close(secondEntered)
+			return nil
+		})
+		secondDone <- err
+	}()
+
+	enteredEarly := false
+	select {
+	case <-secondEntered:
+		enteredEarly = true
+	case <-time.After(100 * time.Millisecond):
+	}
+	close(releaseFirst)
+	require.NoError(t, <-firstDone)
+	require.False(t, enteredEarly, "the second writer entered while the first still held the lock")
+
+	select {
+	case <-secondEntered:
+	case <-time.After(time.Second):
+		t.Fatal("the second refresh did not enter after the first released the lock")
+	}
+	require.NoError(t, <-secondDone)
+}
